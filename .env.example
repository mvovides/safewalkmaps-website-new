# ---------------------------------------------------------------------------
# SafeWalkMaps website — environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Every variable is optional: without them the site still builds and runs,
# and the forms fall back to a clearly-labelled development mode.
# ---------------------------------------------------------------------------

# Web3Forms access key — powers both the iOS waitlist and the contact form.
# Create a free key at https://web3forms.com and point it at your inbox.
# This is a public, write-only submission key (it is safe in client bundles),
# but it is still read from the environment so it can be rotated per deploy.
VITE_WEB3FORMS_ACCESS_KEY=

# Canonical site origin, used for canonical links, OpenGraph URLs and sitemap.
# No trailing slash.
VITE_SITE_URL=https://safewalkmaps.com

# Public contact address shown on the site and used as the mailto fallback
# if a form submission fails.
VITE_CONTACT_EMAIL=safewalkmaps@gmail.com
